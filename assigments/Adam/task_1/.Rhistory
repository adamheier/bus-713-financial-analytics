summarise(
n_months        = n(),
mean_return_m   = mean(monthly.returns),
volatility_m    = sd(monthly.returns),
mean_return_ann = mean(monthly.returns) * 12,
volatility_ann  = sd(monthly.returns) * sqrt(12),
worst_month     = min(monthly.returns),
best_month      = max(monthly.returns),
share_positive  = mean(monthly.returns > 0)
)
risk_summary
# Bar chart: annualised return against annualised volatility
p_risk <- risk_summary %>%
select(asset, Return = mean_return_ann, Volatility = volatility_ann) %>%
pivot_longer(-asset, names_to = "measure", values_to = "value") %>%
ggplot(aes(x = asset, y = value, fill = measure)) +
geom_col(position = "dodge") +
scale_y_continuous(labels = scales::percent) +
labs(
title    = "Annualised return and volatility, 2005-2025",
subtitle = "Based on monthly log returns",
x = "", y = "", fill = ""
) +
theme_bw()
p_risk
ggsave(file.path(out_dir, "05_return_vs_volatility.png"), p_risk, width = 8, height = 5, dpi = 150)
# -----------------------------------------------------------------------------
# 9. Final summary table
# -----------------------------------------------------------------------------
# Summary table pulling together return, risk, tail risk and inflation adjustment.
summary_table <- risk_summary %>%
select(asset, return_ann = mean_return_ann, volatility_ann) %>%
left_join(var_es %>% select(asset, var_95, es_95), by = "asset") %>%
left_join(cagr_table %>% select(asset, cagr_nominal, cagr_real, value_real), by = "asset") %>%
left_join(performance %>% select(asset, sharpe, sortino), by = "asset") %>%
arrange(asset)
# Assets:  NVIDIA (NVDA), Intel (INTC), Nasdaq Composite (^IXIC)
# Period:  1 January 2005 - 31 December 2025
# Data:    Yahoo Finance (prices, adjusted for splits and dividends)
#          FRED (US CPI, series CPIAUCSL)
#
# Structure of this code
#   0. Setup and parameters
#   1. Data import (prices and CPI)
#   2. Prices over time
#   3. Returns (monthly and daily)
#   4. Risk 1: volatility as dispersion of returns
#   5. Risk 2: volatility over time and volatility clustering
#   6. Risk 3: downside risk (VaR, Expected Shortfall)
#   7. Long-run performance: nominal CAGR, inflation and real CAGR
#   8. Risk-adjusted performance (Sharpe, Sortino, beta)
#   9. Final summary table
# -----------------------------------------------------------------------------
# 0. Setup and parameters
# -----------------------------------------------------------------------------
library(tidyquant)   # tq_get() for prices, tq_transmute() for returns
library(tidyverse)   # dplyr / ggplot2 / tibble
library(lubridate)   # floor_date() for grouping days into months
library(forecast)    # Acf() for the autocorrelation function
library(patchwork)   # combines two ggplots into one figure (p_a + p_b)
# Central parameters.
start_date <- "2005-01-01"
end_date   <- "2025-12-31"
tickers <- c("NVDA" = "NVIDIA (NVDA)",
"INTC" = "Intel (INTC)",
"^IXIC" = "Nasdaq Composite")
# Assets are always plotted and tabulated in this order (stocks first, index last)
asset_levels <- c("NVIDIA (NVDA)", "Intel (INTC)", "Nasdaq Composite")
# Fix the default ggplot colours to the three assets. Charts that show only a
# subset of the assets then keep the same colour as the charts showing all three.
asset_colours <- setNames(scales::hue_pal()(length(asset_levels)), asset_levels)
position_value <- 1000000   # USD, used to express VaR / ES in dollar terms
invested       <- 10000     # USD, used for the "growth of an investment" example
out_dir <- "output"
if (!dir.exists(out_dir)) dir.create(out_dir)
# Helper 1: CAGR from a price series (same method as Module 1.5)
calc_cagr <- function(value, date) {
years <- as.numeric(difftime(last(date), first(date), units = "days")) / 365.25
(last(value) / first(value))^(1 / years) - 1
}
# Helper 2: FRED download.
get_fred <- function(series_id, from, to) {
tq_get(series_id, get = "economic.data", from = from, to = to)
}
# -----------------------------------------------------------------------------
# 1. Data import
# -----------------------------------------------------------------------------
# 1.1 Prices from Yahoo Finance.
# "adjusted" accounts for splits and dividends, so it measures what an investor
# actually earned. NVIDIA had several splits (10:1 in 2024), without adjustment
# the return series would show artificial crashes.
# Note: Yahoo treats "to" as exclusive, so we request one day more and filter.
prices <- tq_get(names(tickers), from = start_date, to = "2026-01-01") %>%
filter(date <= as.Date(end_date)) %>%
mutate(asset = factor(tickers[symbol], levels = asset_levels))
prices
# Data check: same number of trading days and identical sample for all assets?
prices %>%
group_by(asset) %>%
summarise(
n_days     = n(),
first_date = min(date),
last_date  = max(date),
first_px   = first(adjusted),
last_px    = last(adjusted)
)
# 1.2 US CPI from FRED (CPIAUCSL, monthly, seasonally adjusted).
# The October 2025 observation is missing in the source data (the US government
# shutdown delayed the BLS release), so NA values are removed explicitly.
cpi <- get_fred("CPIAUCSL", start_date, end_date) %>%
filter(!is.na(price))
cpi
# -----------------------------------------------------------------------------
# 2. Prices over time
# -----------------------------------------------------------------------------
# 2.1 Raw adjusted prices.
# NVDA + INTC: common y-axis, fixed at 0-200 USD.
p_stocks <- prices %>%
filter(asset %in% c("NVIDIA (NVDA)", "Intel (INTC)")) %>%
ggplot(aes(x = date, y = adjusted, colour = asset)) +
geom_line() +
facet_wrap(~ asset) +
coord_cartesian(ylim = c(0, 200)) +
scale_colour_manual(values = asset_colours) +
labs(x = "", y = "Adjusted price (USD)") +
theme_bw() +
theme(legend.position = "none")
# Nasdaq: its own, unchanged scale
p_index <- prices %>%
filter(asset == "Nasdaq Composite") %>%
ggplot(aes(x = date, y = adjusted, colour = asset)) +
geom_line() +
facet_wrap(~ asset) +
scale_colour_manual(values = asset_colours) +
labs(x = "", y = "Index points") +
theme_bw() +
theme(legend.position = "none")
p_prices <- p_stocks + p_index +
plot_annotation(
title    = "Adjusted prices, 2005-2025",
subtitle = "NVDA and INTC share a 0-200 USD scale; Nasdaq uses its own"
)
p_prices
ggsave(file.path(out_dir, "01_prices_levels.png"), p_prices, width = 10, height = 4, dpi = 150)
# 2.2 Indexed prices on a log scale (all series start at 100).
prices_indexed <- prices %>%
group_by(asset) %>%
arrange(date) %>%
mutate(index_100 = 100 * adjusted / first(adjusted)) %>%
ungroup()
p_indexed <- ggplot(prices_indexed, aes(x = date, y = index_100, colour = asset)) +
geom_line(linewidth = 0.6) +
scale_y_log10(labels = scales::comma) +
labs(
title    = "Growth of 100 USD invested on 3 January 2005 (log scale)",
subtitle = "Equal slopes mean equal percentage growth",
x = "", y = "Index (3 Jan 2005 = 100, log scale)", colour = ""
) +
theme_bw() +
theme(legend.position = "bottom")
p_indexed
ggsave(file.path(out_dir, "02_prices_indexed_log.png"), p_indexed, width = 9, height = 5, dpi = 150)
# -----------------------------------------------------------------------------
# 3. Returns
# -----------------------------------------------------------------------------
# 3.1 Monthly log returns - used for the return / volatility comparison.
monthly_returns <- prices %>%
group_by(asset) %>%
tq_transmute(
select     = adjusted,
mutate_fun = periodReturn,
period     = "monthly",
type       = "log"
) %>%
ungroup()
monthly_returns
# 3.2 Daily arithmetic returns - used for volatility clustering and VaR / ES.
daily_returns <- prices %>%
group_by(asset) %>%
tq_transmute(
select     = adjusted,
mutate_fun = periodReturn,
period     = "daily",
type       = "arithmetic"
) %>%
ungroup()
daily_returns
# 3.3 Plot monthly returns
p_monthly <- ggplot(monthly_returns, aes(x = date, y = monthly.returns, colour = asset)) +
geom_line() +
facet_wrap(~ asset, ncol = 1) +
scale_y_continuous(labels = scales::percent) +
labs(
title = "Monthly log returns, 2005-2025",
x = "", y = "Monthly return"
) +
theme_bw() +
theme(legend.position = "none")
p_monthly
ggsave(file.path(out_dir, "03_monthly_returns.png"), p_monthly, width = 9, height = 6, dpi = 150)
# 3.4 Plot daily returns.
p_daily <- ggplot(daily_returns, aes(x = date, y = daily.returns, colour = asset)) +
geom_line(linewidth = 0.2) +
facet_wrap(~ asset, ncol = 1) +
scale_y_continuous(labels = scales::percent) +
labs(
title    = "Daily returns, 2005-2025",
subtitle = "Turbulent days appear in blocks, not scattered at random",
x = "", y = "Daily return"
) +
theme_bw() +
theme(legend.position = "none")
p_daily
ggsave(file.path(out_dir, "04_daily_returns.png"), p_daily, width = 9, height = 6, dpi = 150)
# -----------------------------------------------------------------------------
# 4. Risk 1: volatility as dispersion of returns
# -----------------------------------------------------------------------------
# Volatility = standard deviation of returns. Monthly figures are annualised
# with sqrt(12), daily figures with sqrt(252) trading days.
risk_summary <- monthly_returns %>%
group_by(asset) %>%
summarise(
n_months        = n(),
mean_return_m   = mean(monthly.returns),
volatility_m    = sd(monthly.returns),
mean_return_ann = mean(monthly.returns) * 12,
volatility_ann  = sd(monthly.returns) * sqrt(12),
worst_month     = min(monthly.returns),
best_month      = max(monthly.returns),
share_positive  = mean(monthly.returns > 0)
)
risk_summary
# Bar chart: annualised return against annualised volatility
p_risk <- risk_summary %>%
select(asset, Return = mean_return_ann, Volatility = volatility_ann) %>%
pivot_longer(-asset, names_to = "measure", values_to = "value") %>%
ggplot(aes(x = asset, y = value, fill = measure)) +
geom_col(position = "dodge") +
scale_y_continuous(labels = scales::percent) +
labs(
title    = "Annualised return and volatility, 2005-2025",
subtitle = "Based on monthly log returns",
x = "", y = "", fill = ""
) +
theme_bw()
p_risk
ggsave(file.path(out_dir, "05_return_vs_volatility.png"), p_risk, width = 8, height = 5, dpi = 150)
# -----------------------------------------------------------------------------
# 5. Risk 2: volatility over time and volatility clustering
# -----------------------------------------------------------------------------
# 5.1 Monthly realised volatility: standard deviation of daily returns inside
# each calendar month.
monthly_vol <- daily_returns %>%
mutate(month = floor_date(date, unit = "month")) %>%
group_by(asset, month) %>%
summarise(vol_month = sd(daily.returns), .groups = "drop")
p_mvol <- ggplot(monthly_vol, aes(x = month, y = vol_month, colour = asset)) +
geom_line() +
facet_wrap(~ asset, ncol = 1) +
labs(
title    = "Monthly realised volatility",
subtitle = "Standard deviation of daily returns within each month",
x = "", y = "Monthly volatility"
) +
theme_bw() +
theme(legend.position = "none")
p_mvol
ggsave(file.path(out_dir, "06_monthly_realised_volatility.png"), p_mvol, width = 9, height = 6, dpi = 150)
# Which months were the most turbulent, which were the calmest?
monthly_vol %>% group_by(asset) %>% slice_max(vol_month, n = 5) %>% arrange(asset, desc(vol_month))
monthly_vol %>% group_by(asset) %>% slice_min(vol_month, n = 3) %>% arrange(asset, vol_month)
# 5.2 Squared returns as a volatility proxy.
daily_returns <- daily_returns %>%
mutate(sq_return = daily.returns^2)
# 5.3 Autocorrelation of squared returns. Important for acf_table
plot_acf_grid <- function() {
par(mfrow = c(1, 3))
for (a in asset_levels) {
r <- daily_returns %>% filter(asset == a) %>% pull(sq_return)
Acf(r, lag.max = 50, main = a, na.action = na.omit)
}
par(mfrow = c(1, 1))
}
plot_acf_grid()
png(file.path(out_dir, "07_acf_squared_returns.png"), width = 1200, height = 400, res = 120)
plot_acf_grid()
dev.off()
# Numerical version of the same evidence
acf_table <- map_dfr(asset_levels, function(a) {
r  <- daily_returns %>% filter(asset == a) %>% pull(daily.returns)
ac_sq  <- acf(r^2, lag.max = 50, plot = FALSE)$acf[, , 1]
ac_raw <- acf(r,   lag.max = 50, plot = FALSE)$acf[, , 1]
tibble(
asset      = a,
sq_lag1    = ac_sq[2],  sq_lag5  = ac_sq[6],
sq_lag20   = ac_sq[21], sq_lag50 = ac_sq[51],
raw_lag1   = ac_raw[2]
)
})
acf_table
# -----------------------------------------------------------------------------
# 6. Risk 3: downside risk (VaR, Expected Shortfall)
# -----------------------------------------------------------------------------
# 6.1 Historical VaR and ES at the 95% and 99% level.
# VaR  = the 5th (1st) percentile of the daily return distribution.
# ES   = the average return among the days that were worse than the VaR cutoff.
var_es <- daily_returns %>%
group_by(asset) %>%
summarise(
var_95 = quantile(daily.returns, 0.05),
es_95  = mean(daily.returns[daily.returns <= quantile(daily.returns, 0.05)]),
var_99 = quantile(daily.returns, 0.01),
es_99  = mean(daily.returns[daily.returns <= quantile(daily.returns, 0.01)]),
.groups = "drop"
) %>%
# translate the percentages into money for a fixed position size
mutate(
var_95_usd = -var_95 * position_value,
es_95_usd  = -es_95  * position_value
)
var_es
# 6.2 Distribution of daily returns with the VaR cutoff and the ES marked
p_var <- ggplot(daily_returns, aes(x = daily.returns)) +
geom_histogram(bins = 120, fill = "grey70") +
geom_vline(data = var_es, aes(xintercept = var_95), colour = "red", linewidth = 0.7) +
geom_vline(data = var_es, aes(xintercept = es_95), colour = "darkred",
linewidth = 0.7, linetype = "dashed") +
facet_wrap(~ asset, ncol = 1, scales = "free_y") +
# zoom into +/-20% without discarding observations (coord_cartesian instead of limits)
scale_x_continuous(labels = scales::percent) +
coord_cartesian(xlim = c(-0.20, 0.20)) +
labs(
title    = "Distribution of daily returns with 95% VaR (solid) and ES (dashed)",
subtitle = "Everything left of the red line is the worst 5% of trading days",
x = "Daily return", y = "Frequency"
) +
theme_bw()
p_var
ggsave(file.path(out_dir, "08_var_histograms.png"), p_var, width = 9, height = 7, dpi = 150)
# 6.3 VaR and ES side by side
p_varbar <- var_es %>%
select(asset, VaR = var_95, ES = es_95) %>%
pivot_longer(-asset, names_to = "measure", values_to = "value") %>%
mutate(measure = factor(measure, levels = c("VaR", "ES"))) %>%
ggplot(aes(x = asset, y = value, fill = measure)) +
geom_col(position = "dodge") +
scale_y_continuous(labels = scales::percent) +
labs(
title    = "95% daily Value at Risk and Expected Shortfall",
subtitle = "ES is always the more negative number: it measures severity, VaR only the cutoff",
x = "", y = "Daily return", fill = ""
) +
theme_bw()
p_varbar
ggsave(file.path(out_dir, "09_var_es_comparison.png"), p_varbar, width = 8, height = 5, dpi = 150)
# 6.4 Is the full-sample VaR still the right number today? --> vllt rauslassen?
var_recent <- daily_returns %>%
filter(date >= as.Date("2024-01-01")) %>%
group_by(asset) %>%
summarise(
var_95_recent = quantile(daily.returns, 0.05),
es_95_recent  = mean(daily.returns[daily.returns <= quantile(daily.returns, 0.05)]),
.groups = "drop"
)
var_recent
# -----------------------------------------------------------------------------
# 7. Long-run performance: nominal CAGR, inflation and real CAGR
# -----------------------------------------------------------------------------
# 7.1 Nominal CAGR from the adjusted price series.
cagr_table <- prices %>%
group_by(asset) %>%
summarise(
start_price  = first(adjusted),
end_price    = last(adjusted),
years        = as.numeric(difftime(last(date), first(date), units = "days")) / 365.25,
total_growth = last(adjusted) / first(adjusted),
cagr_nominal = calc_cagr(adjusted, date),
.groups = "drop"
)
cagr_table
# 7.2 Inflation: CAGR of the US CPI over the same period.
cpi_cagr       <- calc_cagr(cpi$price, cpi$date)
cpi_cumulative <- last(cpi$price) / first(cpi$price) - 1
cpi_cagr        # average annual inflation rate 2005-2025
cpi_cumulative  # cumulative price increase over the whole period
# 7.3 Real CAGR via the Fisher equation:
#     (1 + r_real) = (1 + r_nominal) / (1 + inflation)
# Subtracting inflation would overstate the real return, because both rates
# compound.
cagr_table <- cagr_table %>%
mutate(
inflation_cagr = cpi_cagr,
cagr_real      = (1 + cagr_nominal) / (1 + cpi_cagr) - 1,
# what 10,000 USD invested at the start of 2005 turned into
value_nominal  = invested * total_growth,
# and what that amount is worth in 2005 purchasing power
value_real     = invested * total_growth / (1 + cpi_cumulative)
)
cagr_table
# 7.4 Nominal versus real CAGR
p_cagr <- cagr_table %>%
select(asset, Nominal = cagr_nominal, Real = cagr_real) %>%
pivot_longer(-asset, names_to = "type", values_to = "cagr") %>%
mutate(type = factor(type, levels = c("Nominal", "Real"))) %>%
ggplot(aes(x = asset, y = cagr, fill = type)) +
geom_col(position = "dodge") +
geom_hline(yintercept = cpi_cagr, linetype = "dashed", colour = "red") +
annotate("text", x = 0.6, y = cpi_cagr + 0.012,
label = paste0("Inflation ", round(cpi_cagr * 100, 2), "% p.a."),
colour = "red", hjust = 0, size = 3.2) +
scale_y_continuous(labels = scales::percent) +
labs(
title    = "Nominal versus inflation-adjusted CAGR, 2005-2025",
subtitle = "Real CAGR via the Fisher equation, US CPI (CPIAUCSL)",
x = "", y = "Compound annual growth rate", fill = ""
) +
theme_bw()
p_cagr
ggsave(file.path(out_dir, "10_cagr_nominal_vs_real.png"), p_cagr, width = 8, height = 5, dpi = 150)
# 7.5 The same message in money: nominal wealth versus purchasing power.
p_value <- cagr_table %>%
select(asset, Nominal = value_nominal, `Real` = value_real) %>%
pivot_longer(-asset, names_to = "type", values_to = "value") %>%
ggplot(aes(x = asset, y = value, fill = type)) +
geom_col(position = "dodge") +
scale_y_log10(labels = scales::dollar) +
labs(
title    = paste0("Value of ", scales::dollar(invested), " invested in January 2005 (log scale)"),
subtitle = "Inflation leaves about 59% of nominal value intact",
x = "", y = "Value at the end of 2025 (log scale)", fill = ""
) +
theme_bw()
p_value
ggsave(file.path(out_dir, "11_value_of_investment.png"), p_value, width = 8, height = 5, dpi = 150)
# -----------------------------------------------------------------------------
# 8. Risk-adjusted performance
# -----------------------------------------------------------------------------
# Risk-free rate: average 3-month US Treasury bill rate over the same period.
rf_series <- get_fred("TB3MS", start_date, end_date) %>% filter(!is.na(price))
rf_annual <- mean(rf_series$price) / 100
rf_annual
# Arithmetic monthly returns.
monthly_arith <- prices %>%
group_by(asset) %>%
tq_transmute(select = adjusted, mutate_fun = periodReturn,
period = "monthly", type = "arithmetic") %>%
ungroup()
performance <- monthly_arith %>%
group_by(asset) %>%
summarise(
return_ann     = mean(monthly.returns) * 12,
volatility_ann = sd(monthly.returns) * sqrt(12),
# Sharpe: excess return per unit of total risk
sharpe         = (mean(monthly.returns) * 12 - rf_annual) / (sd(monthly.returns) * sqrt(12)),
# Sortino: excess return per unit of downside risk only (Module 3.5)
downside_dev   = sqrt(mean(pmin(0, monthly.returns - rf_annual / 12)^2)) * sqrt(12),
sortino        = (mean(monthly.returns) * 12 - rf_annual) / downside_dev,
.groups = "drop"
)
performance
# -----------------------------------------------------------------------------
# 9. Final summary table
# -----------------------------------------------------------------------------
# Summary table pulling together return, risk, tail risk and inflation adjustment.
summary_table <- risk_summary %>%
select(asset, return_ann = mean_return_ann, volatility_ann) %>%
left_join(var_es %>% select(asset, var_95, es_95), by = "asset") %>%
left_join(cagr_table %>% select(asset, cagr_nominal, cagr_real, value_real), by = "asset") %>%
left_join(performance %>% select(asset, sharpe, sortino), by = "asset") %>%
arrange(asset)
summary_table
# Rounded version
summary_report <- summary_table %>%
transmute(
Asset             = asset,
`Return p.a. %`   = round(return_ann * 100, 1),
`Volatility %`    = round(volatility_ann * 100, 1),
`VaR 95% (daily) %` = round(var_95 * 100, 2),
`ES 95% (daily) %`  = round(es_95 * 100, 2),
`CAGR nominal %`  = round(cagr_nominal * 100, 2),
`CAGR real %`     = round(cagr_real * 100, 2),
`10k -> real USD` = round(value_real, 0),
Sharpe            = round(sharpe, 2),
Sortino           = round(sortino, 2)
)
print(as.data.frame(summary_report))
# -----------------------------------------------------------------------------
# 9. Final summary table
# -----------------------------------------------------------------------------
# Summary table pulling together return, risk, tail risk and inflation adjustment.
summary_table <- risk_summary %>%
select(asset, return_ann = mean_return_ann, volatility_ann) %>%
left_join(var_es %>% select(asset, var_95, es_95), by = "asset") %>%
left_join(cagr_table %>% select(asset, cagr_nominal, cagr_real, value_real), by = "asset") %>%
left_join(performance %>% select(asset, sharpe, sortino), by = "asset") %>%
arrange(asset)
summary_table
# Rounded version
summary_report <- summary_table %>%
transmute(
Asset             = asset,
`Return p.a. %`   = round(return_ann * 100, 1),
`Volatility %`    = round(volatility_ann * 100, 1),
`VaR 95% (daily) %` = round(var_95 * 100, 2),
`ES 95% (daily) %`  = round(es_95 * 100, 2),
`CAGR nominal %`  = round(cagr_nominal * 100, 2),
`CAGR real %`     = round(cagr_real * 100, 2),
`10k -> real USD` = round(value_real, 0),
Sharpe            = round(sharpe, 2),
Sortino           = round(sortino, 2)
)
print(as.data.frame(summary_report))
